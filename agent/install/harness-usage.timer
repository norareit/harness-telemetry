[Unit]
Description=Run harness usage telemetry sync every 5 minutes
Documentation=https://bitbucket.org/ritenoar/harness-telemetry

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Catch up a single missed run after the machine was powered off / logged out.
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
