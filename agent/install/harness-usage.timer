[Unit]
Description=Run harness usage telemetry sync every 5 minutes
Documentation=https://bitbucket.org/ritenoar/harness-telemetry

[Timer]
# OnStartupSec counts from the user manager's start (login). OnBootSec would count from kernel boot: a login more
# than 2 min after boot leaves it already elapsed, the service never runs, and OnUnitActiveSec has no base, so the
# timer stays dead for the whole session (plans/012). Persistent= only applies to OnCalendar=, hence not used.
OnStartupSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
