# Copy to server/.env and edit. server/.env is gitignored.

# Postgres credentials. The agent's config.json DSN must match these.
POSTGRES_USER=harness
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=harness

# Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Bind published ports to this address only. On the Pi this is its Tailscale IP
# (`tailscale ip -4`), so Postgres/Grafana are reachable over the tailnet but not
# from the LAN or the internet. Use 127.0.0.1 to keep everything host-local.
TAILSCALE_IP=100.x.y.z
