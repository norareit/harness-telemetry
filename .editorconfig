# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{sql,plist}]
indent_size = 4

# Single-line SQL strings in JSON can't be wrapped.
[server/grafana/dashboards/*.json]
max_line_length = off

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
